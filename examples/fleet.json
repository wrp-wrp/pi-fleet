{
  "nodes": {
    "edge-1": {
      "transport": "ssh",
      "host": "user@edge1",
      "adapter": "shell",
      "cwd": "/srv/app"
    },
    "gpu-box": {
      "transport": "ssh",
      "host": "user@gpu-host",
      "adapter": "pi-rpc",
      "provider": "anthropic",
      "model": "claude-sonnet-4",
      "tools": ["read", "bash", "edit", "write"],
      "cwd": "/workspace",
      "env": {
        "ANTHROPIC_API_KEY": "$ANTHROPIC_API_KEY",
        "PI_OFFLINE": "1"
      }
    },
    "herms-01": {
      "transport": "websocket",
      "url": "ws://192.168.1.50:8080",
      "adapter": "robot"
    },
    "local-a": {
      "transport": "local",
      "adapter": "pi-rpc",
      "provider": "openai",
      "model": "gpt-4o"
    }
  }
}
